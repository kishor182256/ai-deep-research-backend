APP_NAME="AI Deep Research API"
APP_ENV=development
APP_DEBUG=true
SQL_ECHO=false
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docreader
REDIS_URL=redis://localhost:6379/0
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE_SECONDS=1800

OPENAI_API_KEY=
TAVILY_API_KEY=
ENABLE_EXTERNAL_PROVIDERS=true

DEFAULT_MODEL_PROVIDER=openai
DEFAULT_FAST_MODEL=gpt-4.1-mini
DEFAULT_REASONING_MODEL=gpt-4.1
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Optional MVP cost estimation knobs. Update these to match your provider pricing.
ESTIMATED_FAST_MODEL_COST_PER_1K_TOKENS=0.00015
ESTIMATED_REASONING_MODEL_COST_PER_1K_TOKENS=0.003
ESTIMATED_SEARCH_COST_PER_CALL=0.001

# MVP performance tuning.
SEARCH_QUERY_COUNT=3
REVIEW_SEARCH_QUERY_COUNT=5
SEARCH_PROVIDER_TIMEOUT_SECONDS=8.0
SUGGESTION_GENERATION_TIMEOUT_SECONDS=5.0
REPORT_GENERATION_TIMEOUT_SECONDS=15.0
CONTENT_GENERATION_TIMEOUT_SECONDS=18.0
REPORT_GENERATION_MAX_EVIDENCE_CHUNKS=8
