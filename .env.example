APP_NAME="AI Deep Research API"
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docreader
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
TAVILY_API_KEY=

DEFAULT_MODEL_PROVIDER=openai
DEFAULT_FAST_MODEL=gpt-4.1-mini
DEFAULT_REASONING_MODEL=gpt-4.1
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
